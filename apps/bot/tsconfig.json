{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // tsup transpiles one file at a time with esbuild here as well, so the bot is subject
    // to the same rule the packages are. It was not set, which is why a bare `export
    // { Rule }` of a type compiled fine here and failed the moment apps/web compiled a
    // copy of the same file.
    "isolatedModules": true,
    // vite/client provides the ImportMeta.glob typing used by the command tests.
    "types": ["node", "vite/client"],
    "outDir": "./dist",
    "sourceMap": true,
    // tsc is only used for typechecking now; tsup does the emit.
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*", "*.config.ts"],
  "exclude": ["node_modules", "dist"]
}
