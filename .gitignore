# NuGet's packages folder, from the era before this was a TypeScript project.
# Scoped to nothing now: `packages/` at the repository root is a workspace since
# 5.0.0, and an unanchored `packages/` here matched it - so the entire shared
# package cut would have been silently untracked. Left as a comment rather than
# deleted, because "why is there no NuGet ignore" is a question someone will ask.
*.env
data/
dist/
tsconfig.tsbuildinfo
.yarn/
serverconfig.json
config.json
.yarnrc.yml

# Database schema dumps taken from a live server. Never committed.
# Scoped to the repo root so drizzle/ migration SQL is still tracked - those
# have to be committed or the migration history is meaningless.
/schema.sql
/dump*.sql
/*.dump
/*.tgz

# Next.js
.next/
next-env.d.ts
