{
  "name": "nexus-bot-typescript",
  "type": "module",
  "version": "4.2.0",
  "description": "A Discord bot for Nexus Mods, written in TypeScript",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsup",
    "start": "node dist/shards.js",
    "startWeb": "node dist/web.js",
    "dev": "npm run build && npm run start",
    "devWeb": "npm run build && npm run startWeb",
    "dev:all": "node scripts/dev.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "npm run build && node dist/db/migrate.js",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:check": "graphql-codegen --config codegen.ts && git diff --exit-code src/api/generated",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "Pickysaurus",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^7.3.1",
    "@graphql-codegen/import-types-preset": "^3.0.1",
    "@graphql-codegen/typescript": "^5.0.10",
    "@graphql-codegen/typescript-operations": "^5.1.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.9.1",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.25.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "fuse.js": "^7.5.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "pg": "^8.14.1",
    "pino": "^10.3.1",
    "tall": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "esbuild@0.28.2": true
  }
}
