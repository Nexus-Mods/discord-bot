{
  "name": "nexus-bot-typescript",
  "type": "module",
  "version": "4.0.0",
  "description": "A Discord bot for Nexus Mods, written in TypeScript",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsup",
    "start": "node dist/app.js",
    "startSharded": "node dist/shards.js",
    "dev": "npm run build && npm run start",
    "devShard": "npm run build && npm run startSharded",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --rule '{\"@typescript-eslint/no-floating-promises\":\"error\",\"@typescript-eslint/no-misused-promises\":\"error\"}'",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Pickysaurus",
  "license": "ISC",
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.23.0",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^22.13.14",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "dependencies": {
    "axios": "^1.8.4",
    "cookie-parser": "^1.4.7",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-rate-limit": "^8.6.2",
    "fuse.js": "^7.5.0",
    "graphql": "^16.10.0",
    "graphql-request": "^7.1.2",
    "helmet": "^8.3.0",
    "html-to-text": "^9.0.5",
    "pg": "^8.14.1",
    "pino": "^10.3.1",
    "tall": "^8.0.0"
  }
}
