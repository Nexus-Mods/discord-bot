# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Required by the account-link flow: the OAuth code exchange and every token refresh
# send it. Without it linking fails at the callback, after the user has already
# consented, which is a confusing place to discover a missing variable.
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=
OWNER_IDS=

# Nexus Mods OAuth
# All three are required. NEXUS_OAUTH_ID and NEXUS_REDIRECT_URI are needed to build the
# authorisation URL - without either, the bot logs a warning and hands the user
# /oauth-error - and NEXUS_OAUTH_SECRET is needed to exchange the code and to refresh.
NEXUS_OAUTH_ID=
NEXUS_OAUTH_SECRET=
NEXUS_REDIRECT_URI=

# Database
DBUSER=
DBPASS=
HOST=
DATABASE=
# DBPORT is preferred. PORT is still read as a fallback so existing deployments keep
# working, but PORT is conventionally the HTTP port - the web server uses AUTH_PORT -
# and the two are easy to confuse. Defaults to 5432 if neither is set.
DBPORT=5432
# The automod rules API uses its own database. If this is unset, pg does not error:
# it falls back to the *user name* as the database name, which silently points the
# rules API somewhere else. The bot now refuses to use that pool without it.
AUTOMOD_DATABASE=
# off | on | verify. `on` (the default outside development) encrypts without checking
# the server's certificate, which is the long-standing behaviour: the connection is
# private but not authenticated against an active man-in-the-middle. `verify` is the
# safe setting; set DB_SSL_CA too if the server uses a private root.
#DB_SSL=on
#DB_SSL_CA=
# Give up on a query still running after this many milliseconds, freeing the pool
# connection. 0 disables. This is a client-side timer (pg's query_timeout) rather than
# the server's statement_timeout, because pg sends statement_timeout in the startup
# packet and PgBouncer rejects it. It does not cancel the query on the server - to bound
# that too, set it on the role, where no pooler or deploy can lose it:
#     ALTER ROLE <user> SET statement_timeout = '15s';
#DB_STATEMENT_TIMEOUT_MS=15000

# Connections this process holds open per pool. Default 4.
# The limit is per pool AND per process: three shards hold one pool each, the web
# process holds two (the bot database and the automod database), so the default is a
# ceiling of 20 against a managed Postgres that allows 22. Raise it only if pool
# acquisition starts to queue, and do the arithmetic first.
#DB_POOL_MAX=4

# Number of shards to spawn. Unset means 'auto', which lets Discord decide. Set it to 1
# to run a single shard locally - there is no unsharded mode.
#BOT_SHARD_COUNT=

# Anti-spam bait channel. Leave unset unless the feature is wanted: setting it makes
# the bot request the GuildMessages intent, which delivers every message from every
# server it is in, to be parsed and discarded by everything except this one channel.
#WATCHED_CHANNEL_ID=

# Web server
AUTH_PORT=3000
# Public origin of the auth site. Used to build the links the bot posts in Discord.
SITE_BASE_URL=https://discordbot.nexusmods.com
# Number of reverse proxies in front of the app. Leave unset if there are none.
TRUST_PROXY=

# Secrets - the auth site refuses to start without the first two.
# Signs the OAuth state cookie.
COOKIE_SECRET=
# Signs the /revoke unlink links handed to users in Discord.
UNLINK_SECRET=

# Encryption key for the OAuth tokens in the users table (4.3.0 onward). BOTH the bot
# and the web process refuse to start without it, which is deliberate: a process that
# started without it would write plaintext.
#
# BACK IT UP SOMEWHERE THAT IS NOT THE DROPLET. Every stored token is sealed with it and
# there is no plaintext left to recover from - losing it unlinks every account, all
# ~36,900 of them, permanently. Generate one with:
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# The previous key, during a rotation. Both keys are accepted for reads while it is set.
# Set it, set a new TOKEN_ENCRYPTION_KEY, redeploy, run `npm run tokens:backfill` to
# re-seal, and only remove this once `npm run tokens:verify` reports staleKey 0 - every
# value still on the old key becomes unreadable the moment it goes.
#TOKEN_ENCRYPTION_KEY_OLD=

# Shared secrets for machine-to-machine endpoints. These now FAIL CLOSED:
# if a value is missing, the endpoint it guards rejects every request.
# Guards GET /show-metadata and POST /update-metadata
ADMIN_AUTHCODE=
# Guards the /automod CRUD endpoint
AUTOMOD_AUTHCODE=

# News feed webhook
NEWS_WEBHOOK_ID=
NEWS_WEBHOOK_TOKEN=
NEWS_WEBHOOK_GUILD=
NEWS_WEBHOOK_CHANNEL=

# Moderation webhooks
DISCORD_SUGGESTION_WEBHOOKS=

# development | production | test
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
# Defaults to info in production and debug everywhere else.
LOG_LEVEL=

# Invision forum API, used by the /webhook topic lookup. getTopic throws without it.
FORUM_API_KEY=

# ClickHouse, read by the /tag-votes command only. That command is the sole consumer;
# everything else in the bot works without these.
CLICKHOUSE_KEYID=
CLICKHOUSE_KEYSECRET=
