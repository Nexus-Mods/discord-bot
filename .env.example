# Discord
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_REDIRECT_URI=
OWNER_IDS=

# Nexus Mods OAuth
NEXUS_REDIRECT_URI=

# Database
DBUSER=
DBPASS=
HOST=
DATABASE=
# DBPORT is preferred. PORT is still read as a fallback so existing deployments keep
# working, but PORT is conventionally the HTTP port - the web server uses AUTH_PORT -
# and the two are easy to confuse. Defaults to 5432 if neither is set.
DBPORT=5432
# The automod rules API uses its own database. If this is unset, pg does not error:
# it falls back to the *user name* as the database name, which silently points the
# rules API somewhere else. The bot now refuses to use that pool without it.
AUTOMOD_DATABASE=
# off | on | verify. `on` (the default outside development) encrypts without checking
# the server's certificate, which is the long-standing behaviour: the connection is
# private but not authenticated against an active man-in-the-middle. `verify` is the
# safe setting; set DB_SSL_CA too if the server uses a private root.
#DB_SSL=on
#DB_SSL_CA=
# Cancel any query still running after this many milliseconds. Without it one stuck
# query holds a pool connection until the process restarts.
#DB_STATEMENT_TIMEOUT_MS=15000

# Anti-spam bait channel. Leave unset unless the feature is wanted: setting it makes
# the bot request the GuildMessages intent, which delivers every message from every
# server it is in, to be parsed and discarded by everything except this one channel.
#WATCHED_CHANNEL_ID=

# Web server
AUTH_PORT=3000
# Public origin of the auth site. Used to build the links the bot posts in Discord.
SITE_BASE_URL=https://discordbot.nexusmods.com
# Number of reverse proxies in front of the app. Leave unset if there are none.
TRUST_PROXY=

# Secrets - the auth site refuses to start without the first two.
# Signs the OAuth state cookie.
COOKIE_SECRET=
# Signs the /revoke unlink links handed to users in Discord.
UNLINK_SECRET=

# Shared secrets for machine-to-machine endpoints. These now FAIL CLOSED:
# if a value is missing, the endpoint it guards rejects every request.
# Guards GET /show-metadata and POST /update-metadata
ADMIN_AUTHCODE=
# Guards the /automod CRUD endpoint
AUTOMOD_AUTHCODE=

# News feed webhook
NEWS_WEBHOOK_ID=
NEWS_WEBHOOK_TOKEN=
NEWS_WEBHOOK_GUILD=
NEWS_WEBHOOK_CHANNEL=

# Moderation webhooks
DISCORD_SUGGESTION_WEBHOOKS=

# development | production | test
NODE_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
# Defaults to info in production and debug everywhere else.
LOG_LEVEL=
