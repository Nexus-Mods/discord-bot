{
  "name": "@nexusmods/core",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Cross-cutting primitives shared by the bot and the web app: errors, logging, formatting and environment loading.",
  "exports": {
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "pino-pretty": "^13.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  }
}
