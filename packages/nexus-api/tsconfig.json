{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    // tsup transpiles one file at a time with esbuild, which is exactly what
    // isolatedModules describes. Without this, tsc happily accepts things esbuild cannot
    // emit correctly - a bare `export { SomeType }` compiled fine here and failed the
    // moment apps/web, which does set it, compiled the same file.
    "isolatedModules": true,
    "types": ["node"],
    "outDir": "./dist",
    "sourceMap": true,
    // tsup emits; tsc is only ever asked whether this compiles.
    "noEmit": true
  },
  // codegen.ts is not *.config.ts, so it was outside the project - which meant the
  // linter could not parse it and nothing typechecked the file that generates 3,000
  // lines of types.
  "include": ["src/**/*", "*.config.ts", "codegen.ts"],
  "exclude": ["node_modules", "dist"]
}
